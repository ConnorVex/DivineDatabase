---
// Rolls moved into the admin panel (Players & rolls). Old links land there.
const target = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}admin/review/?type=players`;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Players & rolls</title>
	</head>
	<body>
		<p><a href={target}>Players & rolls moved to the admin panel.</a></p>
	</body>
</html>
